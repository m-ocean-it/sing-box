{
  "log": {
    "level": "debug"
  },
  "dns": {
    "servers": [
      {
        "type": "tls",
        "tag": "google",
        "server": "8.8.8.8"
      }
    ]
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "users": [
        {
          "username": "username",
          "password": "password"
        }
      ],
      "listen": "0.0.0.0",
      "listen_port": 9090
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct-out"
    },
    {
      "type": "socks",
      "tag": "socks-out",
      "server": "127.0.0.1",
      "server_port": 1080
    },
    // {
    //   "type": "urltest",
    //   "tag": "auto-out",
    //   "outbounds": ["direct-out", "socks-out"],
    //   "url": "",
    //   "interval": "1m",
    //   "tolerance": 50,
    //   "idle_timeout": "5m",
    //   "interrupt_exist_connections": false
    // }
    {
      "type": "smart",
      "tag": "auto-out",
      "outbounds": ["direct-out", "socks-out"],
      "required_success_rate": 0.0,
      "recheck_interval": "3m",
      "request_sample_count": 10,
      "required_request_sample_count": 0
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": "mixed-in",
        "outbound": "auto-out"
      }
    ]
  }
}
